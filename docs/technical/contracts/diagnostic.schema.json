{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iaa.core/contracts/diagnostic/v1.0.0",
  "title": "Diagnostic",
  "description": "Sortie de l'Investigateur N2. Lecture seule, aucune action.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hypotheses", "elements_correles", "concluant", "confiance", "justification", "sources"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "hypotheses": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["enonce", "niveau_certitude", "sources"],
        "properties": {
          "enonce": { "type": "string", "minLength": 1 },
          "niveau_certitude": { "type": "number", "minimum": 0, "maximum": 1 },
          "elements_a_verifier": { "type": "array", "items": { "type": "string" } },
          "sources": { "type": "array", "minItems": 1, "items": { "$ref": "https://iaa.core/contracts/source/v1.0.0" } }
        }
      }
    },
    "elements_correles": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "reference"],
        "properties": {
          "type": { "enum": ["log", "ticket_similaire", "evenement", "document"] },
          "reference": { "type": "string" },
          "horodatage": { "type": "string", "format": "date-time" },
          "resume": { "type": "string" }
        }
      }
    },
    "limites": { "type": "array", "items": { "type": "string" }, "description": "Ce que le diagnostic ne couvre pas (XAI)." },
    "concluant": { "type": "boolean", "description": "Faux -> bascule N3." },
    "confiance": { "type": "number", "minimum": 0, "maximum": 1 },
    "justification": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "items": { "$ref": "https://iaa.core/contracts/source/v1.0.0" } }
  }
}
