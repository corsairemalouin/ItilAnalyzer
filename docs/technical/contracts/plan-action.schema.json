{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iaa.core/contracts/plan-action/v1.0.0",
  "title": "PlanAction",
  "description": "Sortie du Resolveur N1. Toutes les actions doivent exister en liste blanche.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runbook_origine", "actions", "reponse_demandeur", "confiance", "justification", "sources"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "runbook_origine": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "version", "etage"],
      "properties": {
        "reference": { "type": "string" },
        "version": { "type": "string" },
        "etage": { "const": "normatif", "description": "Seul le corpus normatif autorise une action (DEC-03)." }
      }
    },
    "actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ordre", "code_action", "reversible", "parametres", "source_etape"],
        "properties": {
          "ordre": { "type": "integer", "minimum": 1 },
          "code_action": { "type": "string", "description": "Doit figurer dans la liste blanche du pack projet." },
          "libelle": { "type": "string" },
          "reversible": { "type": "boolean" },
          "procedure_annulation": { "type": ["string", "null"] },
          "parametres": { "type": "object" },
          "source_etape": { "$ref": "https://iaa.core/contracts/source/v1.0.0" }
        }
      }
    },
    "reponse_demandeur": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["contenu", "mention_ia"],
      "properties": {
        "contenu": { "type": "string" },
        "mention_ia": { "const": true, "description": "Injectee par le composant d'emission, garde-fou absolu n.3." }
      }
    },
    "confiance": { "type": "number", "minimum": 0, "maximum": 1 },
    "justification": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "https://iaa.core/contracts/source/v1.0.0" } }
  }
}
