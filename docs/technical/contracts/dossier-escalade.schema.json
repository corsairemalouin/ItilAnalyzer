{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iaa.core/contracts/dossier-escalade/v1.0.0",
  "title": "DossierEscalade",
  "description": "Sortie du Preparateur N3. EF-07 : conserve tous les identifiants externes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identifiants_externes", "historique", "analyses_realisees",
               "hypotheses", "donnees_collectees", "documents_consultes", "justification_escalade",
               "elements_manquants", "confiance", "justification", "sources"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "identifiants_externes": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["systeme", "identifiant", "role"],
                 "properties": { "systeme": {"type":"string"}, "identifiant": {"type":"string"},
                                 "role": {"enum":["origine","cible_escalade","lie"]} } }
    },
    "historique": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["horodatage", "etape", "resultat"],
                 "properties": { "horodatage": {"type":"string","format":"date-time"},
                                 "etape": {"type":"string"}, "resultat": {"type":"string"},
                                 "acteur": {"enum":["agent","humain"]} } }
    },
    "analyses_realisees": { "type": "array", "items": { "type": "string" } },
    "hypotheses": { "type": "array", "items": { "$ref": "https://iaa.core/contracts/diagnostic/v1.0.0#/properties/hypotheses/items" } },
    "donnees_collectees": { "type": "array", "items": { "type": "object" } },
    "documents_consultes": { "type": "array", "items": { "$ref": "https://iaa.core/contracts/source/v1.0.0" } },
    "justification_escalade": { "type": "string", "minLength": 1 },
    "elements_manquants": { "type": "array", "items": { "type": "string" } },
    "confiance": { "type": "number", "minimum": 0, "maximum": 1 },
    "justification": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "items": { "$ref": "https://iaa.core/contracts/source/v1.0.0" } }
  }
}
