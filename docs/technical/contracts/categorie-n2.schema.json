{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iaa.core/contracts/categorie-n2/v1.0.0",
  "title": "CategorieN2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dans_catalogue", "confiance", "justification", "sources"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "dans_catalogue": { "type": "boolean" },
    "entree_catalogue": { "type": ["string", "null"] },
    "motif_hors_catalogue": { "type": ["string", "null"] },
    "confiance": { "type": "number", "minimum": 0, "maximum": 1 },
    "justification": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "items": { "$ref": "https://iaa.core/contracts/source/v1.0.0" } }
  }
}
