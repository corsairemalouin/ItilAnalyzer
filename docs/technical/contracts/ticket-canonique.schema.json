{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iaa.core/contracts/ticket-canonique/v1.0.0",
  "title": "TicketCanonique",
  "description": "Sortie de l'agent Intake. Representation normalisee et anonymisee d'un ticket entrant.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identifiants_externes", "titre", "description", "langue",
               "score_completude", "doublon", "chemin_declare", "confiance", "justification", "sources"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "identifiants_externes": {
      "type": "array", "minItems": 1,
      "description": "Liste, jamais un identifiant unique (EF-07, R-11).",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["systeme", "identifiant", "role"],
        "properties": {
          "systeme": { "type": "string", "minLength": 1 },
          "identifiant": { "type": "string", "minLength": 1 },
          "role": { "enum": ["origine", "cible_escalade", "lie"] },
          "date_association": { "type": "string", "format": "date-time" }
        }
      }
    },
    "titre": { "type": "string", "maxLength": 500 },
    "description": { "type": "string" },
    "langue": { "type": "string", "pattern": "^[a-z]{2}$" },
    "score_completude": { "type": "number", "minimum": 0, "maximum": 1 },
    "champs_manquants": { "type": "array", "items": { "type": "string" } },
    "questions_demandeur": {
      "type": "array", "maxItems": 3,
      "description": "EF-02 : au plus 3 questions.",
      "items": { "type": "string", "maxLength": 300 }
    },
    "doublon": {
      "type": "object", "additionalProperties": false,
      "required": ["est_doublon"],
      "properties": {
        "est_doublon": { "type": "boolean" },
        "ticket_reference": { "type": "string" },
        "score_similarite": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "chemin_declare": {
      "type": ["string", "null"],
      "description": "Chemin du formulaire guide amont. Sert de pre-classification et de detecteur de mal-dirige."
    },
    "marqueurs": {
      "type": "array",
      "description": "Declenchent le court-circuit permanent du superviseur.",
      "items": { "enum": ["securite", "confidentiel", "impact_vital", "injection_suspectee"] }
    },
    "anonymisation": {
      "type": "object", "additionalProperties": false,
      "required": ["appliquee", "elements_masques"],
      "properties": {
        "appliquee": { "const": true },
        "elements_masques": { "type": "integer", "minimum": 0 },
        "secret_detecte": { "type": "boolean" }
      }
    },
    "confiance": { "type": "number", "minimum": 0, "maximum": 1 },
    "justification": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "items": { "$ref": "https://iaa.core/contracts/source/v1.0.0" } }
  }
}
